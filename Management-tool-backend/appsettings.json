{
  "ConnectionStrings": {
    "DefaultConnection": "<set in appsettings.Development.json>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Host": "<host>",
    "Port": 587,
    "Username": "<username>",
    "Password": "<password>"
  },
  "Jwt": {
    "Key": "<at-least-32-char-secret>",
    "Issuer": "<issuer>",
    "Audience": "<audience>",
    "ExpiresInDays": 7
  }
}